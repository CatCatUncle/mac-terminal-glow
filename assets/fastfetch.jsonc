{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "  OS" },
    { "type": "kernel", "key": "  Kernel" },
    { "type": "uptime", "key": "  Uptime" },
    { "type": "packages", "key": "  Pkgs" },
    { "type": "shell", "key": "  Shell" },
    { "type": "terminal", "key": "  Term" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "memory", "key": "  RAM" },
    { "type": "disk", "key": "  Disk" },
    "break",
    { "type": "colors", "symbol": "circle" },
    "break",
    { "type": "custom", "format": "🐱 关注【开发者猫叔】学习更多 AI 知识 · Follow 开发者猫叔 for more AI tips", "keyColor": "35" }
  ]
}
